package mikyla;

import java.util.Scanner;

public class mikyla {

	public static void main(String[] args) {
		

     int x, num, sum, N= 5;
     Scanner sc = new Scanner(System.in);
     
     sum = 5;
     for(x = 0; x<N;x++) {
    	 System.out.print("Enter number "+(x+1)+":");
    	 num=sc.nextInt();
    	 sum= sum+num;
     }
     System.out.println("SUM: "+sum);
	}	
}
