package Bubblesort;
import java.util.Scanner;
public class Bubblesort {

	public static void main(String[] args) {
	Scanner sc = new Scanner(System.in);
	 int num[] = new int[10];
	  int highest =0;
	 
	 System.out.println("Enter 10 integers: ");
	num[0]=sc.nextInt();
	int lowest =num[0];
	int positive = 0;
	int negative = 0;
	int zero = 0;

	
	for(int i =1; i<num.length;i++) {
		num[i]=sc.nextInt();
		
		if(num[i] < 0)
		   negative++;
		    	
		else if(num[i] > 0)
		      positive++;
		else if(num[i] == 0)
			zero++;
	}
	 	

	for(int i =0; i<num.length - 1; i++) {
		for(int j =0; j<num.length - i- 1; j++) {
			if(num[j] <num[j+1]) {
				int temp = num[j];
				num[j] = num[j+1];
				num[j+1] = temp;
			}
			
		}
	}
	System.out.println("highest : "+ positive );
	System.out.println("lowest: "+ negative);
	System.out.println("lowest: "+ zero);
	System.out.println("Sorted Array: ");
	for(int i = 0; i<num.length; i++) {
		System.out.print(num[i]+" ");
	}
	 }
}
